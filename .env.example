# Base de datos (SQLite por defecto, PostgreSQL en produccion)
DATABASE_URL=sqlite:///./agrovision.db
# DATABASE_URL=postgresql://agro:agro@db:5432/agrovision

# Seguridad JWT
SECRET_KEY=cambia_esto_por_una_clave_fuerte_en_produccion_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modelo IA
MODEL_PATH=./ai_service/models/best.pt
CONFIDENCE_THRESHOLD=0.5

# Rutas
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# API
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860

# Entorno
ENV=development
